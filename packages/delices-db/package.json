{
  "name": "@delices/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SQLite schema and repositories for Les Délices de Grace Lumière",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && cp src/schema.sql dist/schema.sql"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  },
  "dependencies": {
    "@delices/core": "workspace:*"
  }
}
