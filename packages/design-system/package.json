{
  "name": "@harmony/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canonical Harmony Verify design tokens, shared by every app and the static marketing site",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node --experimental-strip-types scripts/sync-tokens.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
