{
  "name": "@harmony/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Domain types, typed errors and identifier helpers shared across Harmony Verify",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
