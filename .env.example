# Harmony Verify — environment template.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; this file is not.
# NEVER put a real key in this file, in code, in a comment, or in a commit message.
# Secrets belong in your local `.env` and in the Vercel project's encrypted
# environment variables — nowhere else.

# --- Identity -------------------------------------------------------------

# The account granted the `admin` role at seed time. Anything else is a customer
# or an expert until an admin promotes it.
ADMIN_EMAIL=yvanadarele@gmail.com

# --- Payments (Paystack) --------------------------------------------------

# Secret key. `sk_test_…` locally, `sk_live_…` only in production.
# Server-side only: this key can move real money and must never be sent to a
# browser, embedded in the static site, or logged.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Public key. Safe to expose — it is what the checkout widget uses.
PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# Paystack signs webhooks with the secret key; set this only if you rotate to a
# dedicated webhook secret.
PAYSTACK_WEBHOOK_SECRET=

# Where Paystack returns the customer after payment.
PAYSTACK_CALLBACK_URL=https://harmonyverify.com/payment/complete

# --- AI (Anthropic) -------------------------------------------------------

# Used by the classification pass and the site assistant. Server-side only.
ANTHROPIC_API_KEY=sk-ant-replace_me
ANTHROPIC_MODEL=claude-sonnet-5

# --- Cryptography ---------------------------------------------------------

# 32 bytes, base64. Encrypts expert bank account numbers at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this without re-encrypting existing rows makes stored account numbers
# unreadable, so treat it as durable state, not a throwaway.
PAYOUT_ENCRYPTION_SECRET=

# Signs session tokens.
SESSION_SECRET=

# --- Runtime --------------------------------------------------------------

DATABASE_PATH=./data/harmony.db
PUBLIC_BASE_URL=http://localhost:4173
NODE_ENV=development


# ==========================================================================
# BRANDORA
# ==========================================================================

# --- Supplier sourcing (AliExpress) ---------------------------------------

# Brandora's initial sourcing integration. Read only by packages/brandora-config,
# used only by packages/brandora-sourcing, which runs server-side.
#
# The App Key is public in AliExpress's model; the other three are not. The App
# Secret signs every request, and the Refresh Token outlives the Access Token —
# a leak of either is a leak of the whole integration, so neither belongs in a
# file, a screenshot, a chat message, or a log line.
#
# In production these are encrypted environment variables in the deployment,
# entered by the Brandora administrator. Admin → Integrations → AliExpress shows
# only a mask of the last four characters, never a value.
#
# If any of these has ever been pasted into a chat, an issue, or a commit,
# rotate it in the AliExpress console before doing anything else.
ALIEXPRESS_APP_KEY=replace_me
ALIEXPRESS_APP_SECRET=replace_me
ALIEXPRESS_ACCESS_TOKEN=replace_me
ALIEXPRESS_REFRESH_TOKEN=replace_me

# The gateway. Override only to point at a regional or sandbox endpoint.
ALIEXPRESS_ENDPOINT=https://api-sg.aliexpress.com/sync

# --- Commercial settings --------------------------------------------------

# Business numbers, deliberately configurable: a margin that can only be changed
# by a deploy is a margin nobody tunes.

# Launch currency. XOF is zero-decimal — see packages/brandora-shared/src/money.ts.
BRANDORA_DEFAULT_CURRENCY=XOF

# Brandora's margin on landed cost. 0.35 = 35%.
BRANDORA_MARGIN_RATE=0.35

# Local handling, storage and last-mile coordination, as a rate on goods.
BRANDORA_LOGISTICS_RATE=0.08

# Where the sourcing strategy changes gear: small orders go to low-MOQ
# suppliers, large ones justify approaching manufacturers directly.
BRANDORA_SOURCING_SMALL_MAX=50
BRANDORA_SOURCING_MEDIUM_MAX=500

# How long cached supplier prices and stock stay fresh. Past this they are still
# served during a supplier outage, but labelled as stale.
BRANDORA_SUPPLIER_CACHE_TTL_MINUTES=360
